CC=gcc
CFLAGS=-I. -Wall -pthread

# Цель по умолчанию
all: parallel_sum

parallel_sum : parallel_sum.o sum_lib.o utils.o
	$(CC) -o parallel_sum parallel_sum.o sum_lib.o utils.o $(CFLAGS)

parallel_sum.o : parallel_sum.c sum_lib.h utils.h
	$(CC) -c -o parallel_sum.o parallel_sum.c $(CFLAGS)

sum_lib.o : sum_lib.c sum_lib.h
	$(CC) -c -o sum_lib.o sum_lib.c $(CFLAGS)

utils.o : utils.c utils.h
	$(CC) -c -o utils.o utils.c $(CFLAGS)

clean :
	rm -f *.o parallel_sum

.PHONY: all clean